#!/usr/bin/env python3
"""Explicitly remove one OMarky chat card or all managed cards on this device."""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

APP_DIR = Path(__file__).resolve().parent.parent / "app"
sys.path.insert(0, str(APP_DIR))

from chat_card import forget_all, forget_card  # noqa: E402


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="omarky-forget",
        description="Remove one short-lived OMarky card, or explicitly remove all managed cards.",
    )
    parser.add_argument("card_id", nargs="?", help="one 32-character lowercase card ID")
    parser.add_argument("--all", action="store_true", dest="all_cards",
                        help="remove all managed OMarky cards on this device")
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.all_cards == bool(args.card_id):
        parser.error("provide exactly one card ID or --all")
    try:
        if args.all_cards:
            removed = forget_all()
            print(f"Removed {removed} managed OMarky card{'s' if removed != 1 else ''}.")
            return 0
        if forget_card(args.card_id):
            print("Removed the requested OMarky card.")
            return 0
        print("No managed OMarky card was found for that ID.", file=sys.stderr)
        return 1
    except (OSError, ValueError) as exc:
        print(f"omarky-forget: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())

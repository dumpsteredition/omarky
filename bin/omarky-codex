#!/usr/bin/env python3
"""Open the real Codex TUI on an owner-private app-server socket for OMarky."""
from __future__ import annotations

import os
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path
from typing import List, Optional

APP_DIR = Path(__file__).resolve().parent.parent / "app"
sys.path.insert(0, str(APP_DIR))

import codex_route  # noqa: E402


_USAGE = """Usage: bin/omarky-codex [--new | --resume THREAD_ID]

Default: start a private Codex app-server and open Codex's existing-chat
resume picker on it. Keep this TUI open while OMarky uses the selected chat.

  --new               Open a new Codex conversation instead of the resume picker
  --resume THREAD_ID  Open the specified existing conversation in Codex
  --help              Show this help

OMARKY_CODEX_BIN may name an installed Codex executable. No credentials,
configuration, or conversation history are copied or rewritten.
"""


def _remove(path: Optional[Path], root: Optional[Path]) -> None:
    if path is None or root is None:
        return
    try:
        if path.parent == root:
            info = path.lstat()
            if info.st_uid == os.getuid() and (socket_mode(info.st_mode) or regular_mode(info.st_mode)
                                                or (path.suffix == ".sock" and symlink_mode(info.st_mode))):
                path.unlink()
    except OSError:
        pass


def socket_mode(mode: int) -> bool:
    import stat
    return stat.S_ISSOCK(mode)


def regular_mode(mode: int) -> bool:
    import stat
    return stat.S_ISREG(mode)


def symlink_mode(mode: int) -> bool:
    import stat
    return stat.S_ISLNK(mode)


def _wait_for_socket(server: subprocess.Popen, path: Path, seconds: float = 20.0) -> bool:
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if server.poll() is not None:
            return False
        if codex_route._codex_socket_is_private(path, path.parent):
            return True
        time.sleep(0.05)
    return False


def _stop_server(server: Optional[subprocess.Popen]) -> None:
    if server is None:
        return
    try:
        os.killpg(server.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    except OSError:
        if server.poll() is None:
            server.terminate()
    try:
        server.wait(timeout=4.0)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(server.pid, signal.SIGKILL)
        except OSError:
            server.kill()
        try:
            server.wait(timeout=3.0)
        except subprocess.TimeoutExpired:
            pass
    # The server has its own process group. Reap any owned descendants as well.
    try:
        os.killpg(server.pid, 0)
    except ProcessLookupError:
        return
    except OSError:
        return
    try:
        os.killpg(server.pid, signal.SIGKILL)
    except OSError:
        pass


def _run(new_conversation: bool, resume_thread_id: Optional[str] = None) -> int:
    binary = codex_route.find_codex_binary()
    if not binary:
        print("OMarky: Codex CLI was not found. Install Codex or set OMARKY_CODEX_BIN.", file=sys.stderr)
        return 127
    root = codex_route.runtime_root(create=True)
    if root is None:
        print("OMarky: no secure owner-private runtime directory is available.", file=sys.stderr)
        return 1
    pid = os.getpid()
    stem = "codex-%d-%s" % (pid, os.urandom(8).hex())
    socket_path = root / (stem + ".sock")
    lease_path: Optional[Path] = None
    server: Optional[subprocess.Popen] = None
    tui: Optional[subprocess.Popen] = None
    pending_signal: List[Optional[int]] = [None]
    old_handlers = {}

    def forward_signal(signum: int, _frame: object) -> None:
        pending_signal[0] = signum
        if tui is not None and tui.poll() is None:
            try:
                tui.send_signal(signum)
            except OSError:
                pass

    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        old_handlers[signum] = signal.signal(signum, forward_signal)

    try:
        if len(os.fsencode(str(socket_path))) >= 104:
            print("OMarky: the runtime socket path is too long for a Unix socket.", file=sys.stderr)
            return 1
        server = subprocess.Popen(
            [binary, "app-server", "--listen", "unix://" + str(socket_path)],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True, close_fds=True,
        )
        if not _wait_for_socket(server, socket_path):
            print("OMarky: Codex app-server did not create its private socket.", file=sys.stderr)
            return 1
        os.chmod(socket_path, 0o600)
        _root, lease_path = codex_route.create_lease(pid, socket_path)
        endpoint = "unix://" + str(socket_path)
        if new_conversation:
            command = [binary, "--remote", endpoint]
        elif resume_thread_id is not None:
            command = [binary, "resume", resume_thread_id, "--remote", endpoint]
        else:
            command = [binary, "resume", "--remote", endpoint]
        if pending_signal[0] is not None:
            return 128 + int(pending_signal[0])
        tui = subprocess.Popen(command, close_fds=True)
        return_code = tui.wait()
        return return_code if return_code >= 0 else 128 + (-return_code)
    except OSError as exc:
        print("OMarky: could not launch the paired Codex TUI or app-server (%s)." % exc.strerror, file=sys.stderr)
        return 1
    finally:
        if tui is not None and tui.poll() is None:
            try:
                tui.terminate()
                tui.wait(timeout=2.0)
            except (OSError, subprocess.TimeoutExpired):
                try:
                    tui.kill()
                except OSError:
                    pass
        if lease_path is not None:
            _remove(lease_path, root)
        _stop_server(server)
        _remove(socket_path, root)
        for signum, handler in old_handlers.items():
            try:
                signal.signal(signum, handler)
            except (OSError, ValueError):
                pass


def main(argv: List[str]) -> int:
    args = list(argv)
    if args in (["--help"], ["-h"]):
        print(_USAGE, end="")
        return 0
    if args == []:
        return _run(new_conversation=False)
    if args == ["--new"]:
        return _run(new_conversation=True)
    if (len(args) == 2 and args[0] == "--resume" and args[1]
            and len(args[1]) <= 256 and not any(ord(char) < 32 or ord(char) == 127 for char in args[1])):
        return _run(new_conversation=False, resume_thread_id=args[1])
    print(_USAGE, file=sys.stderr, end="")
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
